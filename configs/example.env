# Example configuration for the research-data workflow.
# Replace paths with local data locations. Do not commit private data paths.

export MAP_PATH="/path/to/cmb_temperature_map.fits"
export MASK_MAP="/path/to/analysis_mask.fits"
export MAP_NAME="example_map"
export CATALOG_NAME="example_catalog"
export THUMBSTACK_ROOT="/path/to/compatible/thumbstack_checkout"

# Filter stage
export FILTER_TYPES="matchedboth"

# MPV stage
export CHUNK_SIZE=100000
export N_CHUNKS_MAX=100
export N_SHUFFLES=500
export SEED_OFFSET=12345
export MASK_MODE="intersection"
export FILTER_THETA="thetamatched"
export FILTER_PHI="phimatched"
